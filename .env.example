# Copy to .env and fill in what you have. Everything is optional:
# with no keys, DocuSense still runs and answers with its offline extractive mode.

# LLM: auto | anthropic | openai | ollama | extractive
DOCUSENSE_LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
DOCUSENSE_ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
DOCUSENSE_OPENAI_MODEL=gpt-4o-mini
# DOCUSENSE_OPENAI_BASE_URL=   # for Azure or other OpenAI-compatible servers

# Local models via Ollama (in Docker use http://host.docker.internal:11434)
DOCUSENSE_OLLAMA_HOST=http://localhost:11434
DOCUSENSE_OLLAMA_MODEL=llama3.1

# Retrieval
DOCUSENSE_RETRIEVAL_MODE=hybrid   # hybrid | vector | bm25
DOCUSENSE_TOP_K=5
DOCUSENSE_RERANK=true
DOCUSENSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage
DOCUSENSE_DATA_DIR=data/store
DOCUSENSE_MAX_UPLOAD_MB=25
